{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.name,\n            u.created_at,\n            u.updated_at,\n            a.kind::text        AS \"kind!: String\",\n            a.email,\n            a.password_hash,\n            a.provider,\n            a.provider_user_id,\n            a.created_at        AS auth_created_at,\n            a.updated_at        AS auth_updated_at\n        FROM users u\n        INNER JOIN user_auth a ON a.user_id = u.id\n        WHERE a.email = $1\n        ",
