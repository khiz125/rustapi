  "query": "\n            SELECT\n                id,\n                user_id,\n                provider::text AS \"provider!: String\",\n                provider_subscription_id,\n                status::text AS \"status!: String\",\n                plan::text AS \"plan!: String\",\n                started_at,\n                expires_at,\n                created_at,\n                updated_at\n            FROM subscriptions\n            WHERE provider = $1::text::subscription_provider\n              AND provider_subscription_id = $2\n            ",
